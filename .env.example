# Wash Friends RAG System — Environment Variables
# Copy this file to .env and fill in your keys
# Railway: set the SAME names below in the washfriends-rag-bot service only.

# ── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Neo4j AuraDB ────────────────────────────────
NEO4J_URI=neo4j+s://....databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

# ── Zalo OA (THIS app only) ─────────────────────
# Zalo Developer Console → your Wash Friends OA app
ZALO_OA_ACCESS_TOKEN=...   # OA Access Token (refresh when expired)
ZALO_APP_SECRET=...        # App Secret for webhook HMAC

# ── Facebook Messenger (optional) ───────────────
FB_PAGE_TOKEN=...
FB_VERIFY_TOKEN=washfriends_vn_2024
FB_APP_SECRET=...
