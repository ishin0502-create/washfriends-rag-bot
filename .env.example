# Wash Friends RAG System — Environment Variables
# Copy this file to .env and fill in your keys

# ── Claude API (Anthropic) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embedding (OpenAI) ──────────────────────────
# Used for ChromaDB embeddings (text-embedding-3-small)
# If left blank, falls back to local SentenceTransformer (slower, no API cost)
OPENAI_API_KEY=sk-...

# ── Zalo OA ─────────────────────────────────────
# From Zalo OA Developer Console → Your OA → Settings → API
ZALO_OA_TOKEN=...       # OA Access Token (refresh monthly!)
ZALO_APP_SECRET=...     # App Secret (for webhook signature verification)
